{
  "name": "agrijuune",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspaces && npm run check:frontend-secrets && npm run check:performance",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:frontend-secrets": "node scripts/check-frontend-secrets.mjs",
    "check:migrations": "node scripts/check-supabase-migrations.mjs",
    "lint": "eslint frontend backend eslint.config.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test scripts/check-supabase-migrations.test.mjs scripts/check-frontend-secrets.test.mjs && npm run test --workspaces --if-present",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,html,css,json}\" \"backend/**/*.{ts,json}\" \"scripts/check-supabase-migrations*.mjs\" \"scripts/check-frontend-secrets*.mjs\" \"*.{json,js}\"",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,html,css,json}\" \"backend/**/*.{ts,json}\" \"scripts/check-supabase-migrations*.mjs\" \"scripts/check-frontend-secrets*.mjs\" \"*.{json,js}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "supabase": "3.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
